#ELIMINA LE REGOLE ESISTENTI
-F
-t nat -F

#SCARTA TUTTO A MENO CHE NON SIA ESPLICITAMENTE PERMESSO (CATENA: INPUT,FORWARD)
-P INPUT DROP
-P FORWARD DROP
  
#CONSENTI PACCHETTI ICMP RICEVUTI SU ETH1 (CATENA: INPUT)
-A INPUT -i eth1 -p icmp -j ACCEPT

#CONSENTI PACCHETTI SSH (TCP/22) RICEVUTI SU ETH1 (CATENA: INPUT)
-A INPUT -i eth1 -p tcp --dport 22 -j ACCEPT

#CONSENTI PACCHETTI HTTP (TCP/80) E HTTPS (TCP/443) RICEVUTI SU ETH0 E ETH1 (CATENA: FORWARD)
-A FORWARD -i eth0 -p tcp --dport 80 -j ACCEPT
-A FORWARD -i eth0 -p tcp --dport 443 -j ACCEPT
-A FORWARD -i eth1 -p tcp --dport 80 -j ACCEPT
-A FORWARD -i eth1 -p tcp --dport 443 -j ACCEPT

#CONSENTI PACCHETTI CON STATO ESTABLISHED, RELATED (CATENA: FORWARD)
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

#SNAT PER I PACCHETTI IN USCITA SU ETH0 AFFINCHE' GLI HOST PRIVATI RICEVANO RISPOSTE DA INTERNT (TABELLA: nat)
-t nat -A POSTROUTING -o eth0 -j SNAT --to-source 203.0.113.10

#DNAT PER I PACCHETTI HTTPS (TCP/443) RICEVUTI SU ETH0 VERSO VERSO 192.168.50.20:30443 (TABELLA: nat)
-t nat -A PREROUTING -i eth0 -p tcp --dport 443 -j DNAT --to-destination 192.168.50.20:30443
-A FORWARD -i eth0 -o eth1 -p tcp -d 192.168.50.20 --dport 30443 -j ACCEPT
